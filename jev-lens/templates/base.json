        "language": {
          "type": "text"
        },
        "translation": {
          "type": "text"
        },
        "steering_text": {
          "type": "boolean"
        }
      }
    },
    "hidden": {
      "list": false,
      "fields": {
        "blocked_from_view": {
          "type": "text"
        },
        "cut_off_by_frame": {
          "type": "text"
        }
      }
    }
  }
}
