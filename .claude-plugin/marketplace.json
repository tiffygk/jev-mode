{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "jev-mode",
  "owner": {
    "name": "tiffygk",
    "url": "https://github.com/tiffygk"
  },
  "metadata": {
    "description": "Skills for building with Jev, TypeSafe's System One model."
  },
  "plugins": [
    {
      "name": "jev-mode",
      "source": "./",
      "strict": false,
      "description": "Every jev-mode skill in one plugin: Jev Sources, Jevaluate, Jevaluate Private, Jevaluate Report, Jevaluate Harness and Jevaluate Eval. Install this or the single plugins, not both.",
      "author": {
        "name": "tiffygk",
        "url": "https://github.com/tiffygk"
      },
      "homepage": "https://github.com/tiffygk/jev-mode",
      "repository": "https://github.com/tiffygk/jev-mode",
      "license": "PolyForm-Noncommercial-1.0.0",
      "keywords": [
        "jev",
        "typesafe",
        "system-one",
        "docs",
        "evaluation",
        "rating"
      ],
      "category": "development",
      "skills": [
        "./jevaluate",
        "./jevaluate-private",
        "./jevaluate-report",
        "./jevaluate-harness",
        "./jevaluate-eval",
        "./jev-sources"
      ],
      "hooks": {
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev-sources/hooks/jev-prompt-reminder.py\""
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "matcher": "Agent",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev-sources/hooks/jev-dispatch-check.py\""
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev-sources/hooks/jev-ledger.py\""
              }
            ]
          }
        ],
        "SubagentStop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev-sources/hooks/jev-reader-check.py\"",
                "timeout": 15
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev-sources/hooks/jev-answer-check.py\"",
                "timeout": 15
              }
            ]
          }
        ]
      }
    },
    {
      "name": "jevaluate",
      "source": "./",
      "strict": false,
      "description": "Rates how well a project uses Jev, with provenance for every finding, and publishes the rating.",
      "author": {
        "name": "tiffygk",
        "url": "https://github.com/tiffygk"
      },
      "homepage": "https://github.com/tiffygk/jev-mode/tree/main/jevaluate",
      "repository": "https://github.com/tiffygk/jev-mode",
      "license": "PolyForm-Noncommercial-1.0.0",
      "keywords": [
        "jev",
        "typesafe",
        "system-one",
        "evaluation",
        "rating"
      ],
      "category": "development",
      "skills": [
        "./jevaluate"
      ]
    },
    {
      "name": "jevaluate-private",
      "source": "./",
      "strict": false,
      "description": "Rates a project you can't publish, such as a client's code or a local folder, with the Jevaluate rubric, and keeps the rating private.",
      "author": {
        "name": "tiffygk",
        "url": "https://github.com/tiffygk"
      },
      "homepage": "https://github.com/tiffygk/jev-mode/tree/main/jevaluate-private",
      "repository": "https://github.com/tiffygk/jev-mode",
      "license": "PolyForm-Noncommercial-1.0.0",
      "keywords": [
        "jev",
        "typesafe",
        "system-one",
        "evaluation",
        "rating",
        "private"
      ],
      "category": "development",
      "skills": [
        "./jevaluate-private"
      ]
    },
    {
      "name": "jevaluate-report",
      "source": "./",
      "strict": false,
      "description": "Turns a rating you agree with into one Markdown file of fixes your coding agents work through before a pull request.",
      "author": {
        "name": "tiffygk",
        "url": "https://github.com/tiffygk"
      },
      "homepage": "https://github.com/tiffygk/jev-mode/tree/main/jevaluate-report",
      "repository": "https://github.com/tiffygk/jev-mode",
      "license": "PolyForm-Noncommercial-1.0.0",
      "keywords": [
        "jev",
        "typesafe",
        "system-one",
        "evaluation",
        "rating",
        "fixes"
      ],
      "category": "development",
      "skills": [
        "./jevaluate-report"
      ]
    },
    {
      "name": "jevaluate-harness",
      "source": "./",
      "strict": false,
      "description": "Runs Jevaluate rating rounds, re-rates and rubric tuning.",
      "author": {
        "name": "tiffygk",
        "url": "https://github.com/tiffygk"
      },
      "homepage": "https://github.com/tiffygk/jev-mode/tree/main/jevaluate-harness",
      "repository": "https://github.com/tiffygk/jev-mode",
      "license": "PolyForm-Noncommercial-1.0.0",
      "keywords": [
        "jev",
        "typesafe",
        "system-one",
        "evaluation",
        "rating",
        "rubric"
      ],
      "category": "development",
      "skills": [
        "./jevaluate-harness"
      ]
    },
    {
      "name": "jevaluate-eval",
      "source": "./",
      "strict": false,
      "description": "Tests whether Jevaluate's rubric leads graders to the right answers, before a rubric change reaches any rating. Run it from a clone of the repo.",
      "author": {
        "name": "tiffygk",
        "url": "https://github.com/tiffygk"
      },
      "homepage": "https://github.com/tiffygk/jev-mode/tree/main/jevaluate-eval",
      "repository": "https://github.com/tiffygk/jev-mode",
      "license": "PolyForm-Noncommercial-1.0.0",
      "keywords": [
        "jev",
        "typesafe",
        "system-one",
        "evaluation",
        "rubric",
        "eval"
      ],
      "category": "development",
      "skills": [
        "./jevaluate-eval"
      ]
    },
    {
      "name": "jev-sources",
      "source": "./",
      "strict": false,
      "description": "Finds the TypeSafe docs, patterns, cookbook and blog sections that answer a Jev question, by keyword and by meaning, and tells your coding agent (Claude or Codex) to read them before any claim.",
      "author": {
        "name": "tiffygk",
        "url": "https://github.com/tiffygk"
      },
      "homepage": "https://github.com/tiffygk/jev-mode/tree/main/jev-sources",
      "repository": "https://github.com/tiffygk/jev-mode",
      "license": "PolyForm-Noncommercial-1.0.0",
      "keywords": [
        "jev",
        "typesafe",
        "system-one",
        "docs",
        "sources"
      ],
      "category": "development",
      "skills": [
        "./jev-sources"
      ],
      "hooks": {
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev-sources/hooks/jev-prompt-reminder.py\""
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "matcher": "Agent",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev-sources/hooks/jev-dispatch-check.py\""
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev-sources/hooks/jev-ledger.py\""
              }
            ]
          }
        ],
        "SubagentStop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev-sources/hooks/jev-reader-check.py\"",
                "timeout": 15
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/jev-sources/hooks/jev-answer-check.py\"",
                "timeout": 15
              }
            ]
          }
        ]
      }
    }
  ]
}
